# Backend runtime configuration.
# The deploy pipeline reads this file during build-context preparation, so it
# must exist in the workspace even when a value is left at its default.
# Real secrets belong in the platform secrets manager, not in this file.

MONGO_URL=mongodb://localhost:27017
DB_NAME=mums_cubs

# Comma-separated list of allowed browser origins. "*" allows any origin.
CORS_ORIGINS=*
